# ================================
# 🔥 FIREBASE CONFIGURATION
# ================================
# Get these values from Firebase Console (https://console.firebase.google.com/)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ================================
# 📧 MAILGUN EMAIL CONFIGURATION
# ================================
# Sign up at https://www.mailgun.com/ (free tier: 5,000 emails/month)
VITE_MAILGUN_API_KEY=your-mailgun-api-key-here
VITE_MAILGUN_PRIVATE_KEY=key-your-private-key-here
VITE_MAILGUN_DOMAIN=your-mailgun-domain-here
VITE_FROM_EMAIL=noreply@your-domain.com

# ================================
# 💳 STRIPE CONFIGURATION (Optional)
# ================================
# Get from https://stripe.com/ dashboard - for payment processing
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ================================
# 🔧 DEVELOPMENT SETTINGS
# ================================
NODE_ENV=development
VITE_APP_URL=http://localhost:5173

# ================================
# 🚀 PRODUCTION SETTINGS
# ================================
# Uncomment these for production deployment
# NODE_ENV=production
# VITE_APP_URL=https://your-domain.com
