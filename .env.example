# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_APPCHECK_DEBUG_TOKEN=local-dev-token

# Mailgun Configuration
VITE_MAILGUN_API_KEY=your-mailgun-api-key-here
VITE_MAILGUN_PRIVATE_KEY=key-your-private-key-here
VITE_MAILGUN_DOMAIN=your-mailgun-domain-here
VITE_FROM_EMAIL=noreply@your-domain.com
noreplypass=your-noreply-password

# Ejemplo:
# VITE_MAILGUN_API_KEY=key-1234567890abcdef1234567890abcdef
# VITE_MAILGUN_DOMAIN=mg.tudominio.com
# VITE_FROM_EMAIL=noreply@tudominio.com
